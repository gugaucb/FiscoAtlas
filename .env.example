# Porta exposta no host (aplicação responde em http://localhost:APP_PORT)
APP_PORT=8000

# Caminhos persistentes DENTRO do container (volumes do compose)
# DATABASE_URL=sqlite:////data/db.sqlite3
# VAULT_DB_PATH=/data/vault.sqlite3
# DOCUMENT_STORAGE_PATH=/data/documents

# Chave de sessão do Django — use um valor aleatório em produção
# (ex.: python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=

# Modo debug do Django — False no Docker (padrão); True apenas para desenvolvimento local
# DJANGO_DEBUG=False
